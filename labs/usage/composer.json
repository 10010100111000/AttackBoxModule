{
  "name": "trytopwn/usage-reconstruction",
  "type": "project",
  "description": "HTB Usage-inspired real Laravel/MySQL blind SQL injection and Laravel-admin upload lab",
  "license": "UNLICENSED",
  "require": {
    "php": "^8.1",
    "ext-bcmath": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-tokenizer": "*",
    "ext-xml": "*",
    "encore/laravel-admin": "1.8.19",
    "laravel/framework": "10.18.0",
    "laravel/sanctum": "3.3.3",
    "laravel/tinker": "2.8.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    },
    "platform": {
      "php": "8.1.2"
    },
    "policy": {
      "advisories": {
        "ignore-id": [
          "PKSA-fwvh-pm3c-1m7b",
          "PKSA-yxbx-3c9s-cjt9",
          "PKSA-b41t-wbzk-9q51",
          "PKSA-d5tc-s1qs-h781",
          "PKSA-3r5d-mb8f-1qw9",
          "PKSA-m5cs-t1y6-qpcs",
          "PKSA-mdq4-51ck-6kdq",
          "PKSA-8qx3-n5y5-vvnd",
          "PKSA-w7xr-vk7n-rstm"
        ]
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
