FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      ca-certificates curl python3 python3-requests openssh-client sshpass expect \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /tests
COPY attack_path.py /tests/attack_path.py
COPY nano-root.exp /tests/nano-root.exp
USER 65534:65534
ENTRYPOINT ["python3", "/tests/attack_path.py"]
