# DEBIAN TEST BRANCH ONLY. Real upstream PHP, MySQL, ZoneMinder and Tomcat.
# Never expose on a public network or merge without complete exploit acceptance.
FROM alpine:3.20 AS tomcat-artifact
RUN apk add --no-cache ca-certificates curl tar coreutils
ARG TOMCAT_VERSION=9.0.30
ARG TOMCAT_SHA512=40bf428a534816317e5e8732b679e6d73f6ed977aab4ac5e2b9eaf1eb087eaa68a18b0fd3da8c39ca4b96f5b6fd919dec84517abba0d5e797285ade934a92990
RUN set -eux; \
    curl -fL --retry 3 --connect-timeout 15 --output /tmp/tomcat.tar.gz \
      "https://archive.apache.org/dist/tomcat/tomcat-9/v${TOMCAT_VERSION}/bin/apache-tomcat-${TOMCAT_VERSION}.tar.gz"; \
    printf '%s  %s\n' "$TOMCAT_SHA512" /tmp/tomcat.tar.gz | sha512sum -c -; \
    mkdir -p /opt/tomcat; \
    tar -xzf /tmp/tomcat.tar.gz --strip-components=1 -C /opt/tomcat; \
    test -f /opt/tomcat/RELEASE-NOTES


FROM alpine:3.20 AS mysql-artifact
RUN apk add --no-cache curl ca-certificates coreutils
COPY debian/mysql-5.7.30.sha256 /tmp/mysql.sha256
RUN set -eux; mkdir -p /debs; \
  for pkg in mysql-common libmysqlclient20 mysql-community-client mysql-client mysql-community-server; do \
    file="$pkg"_5.7.30-1debian8_amd64.deb; \
    curl -fL --retry 3 --connect-timeout 20 -o "/debs/$file" \
      "https://repo.mysql.com/apt/debian/pool/mysql-5.7/m/mysql-community/$file"; \
  done; \
  sha256sum -c /tmp/mysql.sha256

FROM debian/eol:jessie-slim AS debian-assembled
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64 \
    CATALINA_HOME=/opt/tomcat \
    CATALINA_BASE=/opt/tomcat \
    JAVA_OPTS="-Xms32m -Xmx128m -Djava.security.egd=file:/dev/./urandom" \
    PEBBLES_MYSQL_BOOTSTRAP=pebbles-bootstrap-only \
    PEBBLES_ZM_PASSWORD=zmpass
COPY --from=mysql-artifact /debs/ /tmp/mysql-debs/
RUN set -eux; \
  printf '%s\n' \
    'deb http://archive.debian.org/debian jessie main contrib non-free' \
    'deb http://archive.debian.org/debian jessie-backports main contrib non-free' \
    'deb http://archive.debian.org/debian-security jessie/updates main contrib non-free' \
    > /etc/apt/sources.list; \
  printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99-archive; \
  printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d; \
  chmod 0755 /usr/sbin/policy-rc.d; \
  mkdir -p /etc/mysql/conf.d; \
  printf '[mysqld]\ninnodb_log_file_size=8M\n' > /etc/mysql/conf.d/99-pebbles-redo-size.cnf; \
  # Keep upstream licenses while omitting optional non-runtime manual pages
  # and translations as packages are extracted into the assembled image.
  printf '%s\n' \
    'path-exclude=/usr/share/man/*' \
    'path-exclude=/usr/share/info/*' \
    'path-exclude=/usr/share/locale/*' \
    'path-exclude=/usr/share/doc/*' \
    'path-include=/usr/share/doc/*/copyright' \
    > /etc/dpkg/dpkg.cfg.d/01-pebbles-small; \
  apt-get update; \
  apt-get install -y --no-install-recommends \
    libaio1 libnuma1 libmecab2 libsasl2-2 libncurses5 libtinfo5 \
    perl psmisc adduser debconf init-system-helpers ca-certificates \
    apache2 libapache2-mod-php5 php5-cli php5-mysql php5-gd php5-json php5-curl \
    curl procps vsftpd openssh-server netcat-openbsd util-linux; \
  printf '%s\n' \
    'mysql-community-server mysql-community-server/root-pass password pebbles-bootstrap-only' \
    'mysql-community-server mysql-community-server/re-root-pass password pebbles-bootstrap-only' \
    | debconf-set-selections; \
  dpkg -i \
    /tmp/mysql-debs/mysql-common_5.7.30-1debian8_amd64.deb \
    /tmp/mysql-debs/libmysqlclient20_5.7.30-1debian8_amd64.deb \
    /tmp/mysql-debs/mysql-community-client_5.7.30-1debian8_amd64.deb \
    /tmp/mysql-debs/mysql-client_5.7.30-1debian8_amd64.deb \
    /tmp/mysql-debs/mysql-community-server_5.7.30-1debian8_amd64.deb; \
  apt-get -t jessie-backports install -y --no-install-recommends \
    zoneminder=1.29.0+dfsg-1~bpo8+1 openjdk-8-jre-headless; \
  dpkg-query -W zoneminder mysql-community-server openjdk-8-jre-headless; \
  test -f /usr/share/zoneminder/www/ajax/log.php; \
  test -f /usr/share/zoneminder/db/zm_create.sql; \
  chown -R www-data:www-data /usr/share/zoneminder; \
  chown -R root:root /var/lib/mysql; \
  chown root:www-data /etc/zm/zm.conf; \
  chmod 0640 /etc/zm/zm.conf; \
  apt-get clean; \
  rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb /tmp/mysql-debs

RUN useradd --system --user-group --home /opt/tomcat --shell /usr/sbin/nologin tomcat
COPY --from=tomcat-artifact --chown=tomcat:tomcat /opt/tomcat/ /opt/tomcat/
COPY site80/public/ /var/www/pebbles/
# PHP 5.6 supports the same login behavior but not PHP 7 syntax. This is
# only the non-exploitable 80/tcp decoy, not the original ZoneMinder backend.
COPY debian/index.php /var/www/pebbles/index.php
COPY config/apache-pebbles.conf /etc/apache2/sites-available/pebbles.conf
COPY config/pebbles-vsftpd.conf /etc/vsftpd.conf
COPY config/sshd-pebbles.conf /tmp/sshd-pebbles.conf
COPY scripts/entrypoint.sh /usr/local/bin/pebbles-entrypoint
COPY debian/healthcheck.sh /usr/local/bin/pebbles-healthcheck
COPY flags/root.txt /root/proof.txt

RUN set -eux; \
  mkdir -p /run/mysqld /run/sshd /run/zm /var/log/mysql /var/log/zoneminder \
    /var/www/pebbles /opt/tomcat/temp /opt/tomcat/logs /opt/tomcat/work; \
  test -f /opt/tomcat/RELEASE-NOTES; \
  grep -q 'port="8080" protocol="HTTP/1.1"' /opt/tomcat/conf/server.xml; \
  sed -i 's/port="8009" protocol="AJP\/1.3"/port="8009" address="127.0.0.1" protocol="AJP\/1.3"/' /opt/tomcat/conf/server.xml; \
  php -l /var/www/pebbles/index.php; \
  test -f /var/www/html/index.html; \
  a2dissite 000-default; \
  a2ensite pebbles; \
  a2enmod cgi rewrite headers; \
  a2enconf zoneminder; \
  cat /tmp/sshd-pebbles.conf >> /etc/ssh/sshd_config; \
  chmod 0755 /usr/local/bin/pebbles-entrypoint /usr/local/bin/pebbles-healthcheck; \
  chmod 0600 /root/proof.txt; \
  chown root:root /root/proof.txt; \
  if test -f /etc/mysql/mysql.conf.d/mysqld.cnf; then \
    sed -ri '/^[[:space:]]*user[[:space:]]*=[[:space:]]*mysql([[:space:]]*#.*)?$/d' /etc/mysql/mysql.conf.d/mysqld.cnf; \
  fi; \
  chmod 0755 /var/www/html; \
  mkdir -p /etc/php5/apache2/conf.d; \
  printf 'date.timezone = UTC\n' > /etc/php5/apache2/conf.d/99-pebbles-timezone.ini; \
  ln -sf /opt/tomcat/RELEASE-NOTES /opt/tomcat/webapps/ROOT/RELEASE-NOTES.txt

FROM scratch AS debian-runtime
COPY --from=debian-assembled / /
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64 \
    CATALINA_HOME=/opt/tomcat \
    CATALINA_BASE=/opt/tomcat \
    JAVA_OPTS="-Xms32m -Xmx128m -Djava.security.egd=file:/dev/./urandom" \
    PEBBLES_MYSQL_BOOTSTRAP=pebbles-bootstrap-only \
    PEBBLES_ZM_PASSWORD=zmpass
EXPOSE 21 22 80 3305 8080
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=12s --start-period=180s --retries=4 \
  CMD ["/usr/local/bin/pebbles-healthcheck"]
ENTRYPOINT ["/usr/local/bin/pebbles-entrypoint"]
